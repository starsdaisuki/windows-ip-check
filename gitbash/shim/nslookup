#!/bin/bash
# nslookup shim: run Windows nslookup.exe, re-emit in the GNU/Linux layout ip.sh parses
# (Check_DNS_1 wants the token after "Name:" +3 to be the answer, and token[1] to be the server IP).
# Works on Chinese Windows too ("名称:" / "地址:"), because we key on IPv4 shapes, not labels.
[ -n "$1" ] || exit 1
out=$(/c/Windows/System32/nslookup.exe "$1" 2>/dev/null | tr -d '\r' | iconv -f GBK -t UTF-8 2>/dev/null || /c/Windows/System32/nslookup.exe "$1" 2>/dev/null | tr -d '\r')
srv=""; ans=""; seen_name=0
while IFS= read -r line; do
  if [[ $line =~ ^(Name|名称|名稱)[[:space:]]*: ]]; then seen_name=1; continue; fi
  if [[ $line =~ ([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}) ]]; then
    ip="${BASH_REMATCH[1]}"
    if [ $seen_name -eq 0 ]; then [ -z "$srv" ] && srv="$ip"
    else [ -z "$ans" ] && ans="$ip"; fi
  fi
done <<< "$out"
[ -n "$srv" ] || srv="0.0.0.0"
printf 'Server:\t\t%s\nAddress:\t%s#53\n\nNon-authoritative answer:\nName:\t%s\nAddress: %s\n' "$srv" "$srv" "$1" "${ans:-0.0.0.0}"
